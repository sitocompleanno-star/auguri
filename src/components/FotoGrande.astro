---
// Foto in grande (Fase 7): una finestra <dialog> condivisa da home e Archivio.
// Si apre toccando un elemento con `data-foto-grande` e gli attributi data-id, data-w, data-h, data-alt
// (li scrivono la home e l'Archivio). Con `data-gruppo` uguale su più elementi si scorre tra le foto
// (frecce, tasti ← →, scorrimento col dito). Esc, la × o un tocco fuori dalla foto chiudono.
const base = import.meta.env.BASE_URL;
---
<dialog class="fg" data-fg data-base={base} aria-label="Foto in grande">
  <form method="dialog" class="fg__chiudi-form">
    <button class="fg__chiudi" aria-label="Chiudi">×</button>
  </form>
  <figure class="fg__figura">
    <img class="fg__img" data-fg-img alt="" decoding="async" />
  </figure>
  <div class="fg__nav" data-fg-nav hidden>
    <button type="button" class="fg__freccia" data-fg-prec aria-label="Foto precedente">‹</button>
    <span class="fg__conta" data-fg-conta aria-live="polite"></span>
    <button type="button" class="fg__freccia" data-fg-succ aria-label="Foto successiva">›</button>
  </div>
</dialog>

<script>
  const fg = document.querySelector<HTMLDialogElement>('[data-fg]')!;
  const img = fg.querySelector<HTMLImageElement>('[data-fg-img]')!;
  const nav = fg.querySelector<HTMLElement>('[data-fg-nav]')!;
  const conta = fg.querySelector<HTMLElement>('[data-fg-conta]')!;
  const base = fg.dataset.base!;
  let gruppo: HTMLElement[] = [];
  let indice = 0;
  let origine: HTMLElement | null = null;

  function mostra(el: HTMLElement) {
    const { id, w, h, alt } = el.dataset;
    const src = (m: number) => `${base}media/foto/${id}-${m}.webp`;
    img.removeAttribute('src');
    img.width = Number(w);
    img.height = Number(h);
    img.alt = alt ?? '';
    // la versione da 800 è già in cache (home): il browser sceglie la 1600 sugli schermi ad alta densità
    img.srcset = `${src(800)} 800w, ${src(1600)} 1600w`;
    img.sizes = 'min(100vw, 430px)';
    img.src = src(1600);
    if (gruppo.length > 1) conta.textContent = `${indice + 1} di ${gruppo.length}`;
  }

  function vai(passo: number) {
    if (gruppo.length < 2) return;
    indice = (indice + passo + gruppo.length) % gruppo.length;
    mostra(gruppo[indice]);
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('[data-foto-grande]');
    if (!el || !el.dataset.id) return;
    origine = el;
    const g = el.dataset.gruppo;
    gruppo = g ? [...document.querySelectorAll<HTMLElement>(`[data-foto-grande][data-gruppo="${g}"]`)] : [el];
    indice = Math.max(0, gruppo.indexOf(el));
    nav.hidden = gruppo.length < 2;
    mostra(el);
    fg.showModal();
  });

  fg.querySelector('[data-fg-prec]')!.addEventListener('click', () => vai(-1));
  fg.querySelector('[data-fg-succ]')!.addEventListener('click', () => vai(1));
  fg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); vai(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); vai(1); }
  });
  // tocco fuori dalla foto (sullo sfondo della finestra) = chiudi
  fg.addEventListener('click', (e) => {
    if (e.target === fg || (e.target as Element).classList.contains('fg__figura')) fg.close();
  });
  // scorrimento orizzontale col dito
  let x0: number | null = null;
  fg.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
  fg.addEventListener('pointerup', (e) => {
    if (x0 === null) return;
    const dx = e.clientX - x0;
    x0 = null;
    if (Math.abs(dx) > 50) vai(dx < 0 ? 1 : -1);
  });
  fg.addEventListener('close', () => {
    img.removeAttribute('src');
    img.removeAttribute('srcset');
    origine?.focus();
  });
</script>

<style>
  .fg {
    width: 100%;
    max-width: var(--larghezza-foglio);
    height: 100dvh;
    max-height: none;
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }
  .fg[open] {
    display: flex;
    flex-direction: column;
    animation: fg-entra 220ms ease-out;
  }
  .fg::backdrop {
    background: rgb(34 31 32 / 0.92);
  }
  .fg__chiudi-form {
    display: flex;
    justify-content: flex-end;
    padding: 8px;
  }
  .fg__chiudi,
  .fg__freccia {
    min-width: 44px;
    min-height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .fg__chiudi:focus-visible,
  .fg__freccia:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  .fg__figura {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fg__img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.06);
  }
  .fg__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 12px 8px max(16px, env(safe-area-inset-bottom));
    font-family: var(--font-ui);
    font-size: 15px;
  }
  .fg__nav[hidden] { display: none; }
  @keyframes fg-entra {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fg[open] { animation: none; }
  }
</style>
