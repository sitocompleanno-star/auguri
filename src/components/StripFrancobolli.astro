---
// Striscia "Collezione di francobolli": slot pieni (ottenuti) e vuoti fino a `totale`.
// Gli slot vuoti sono l'SVG definitivo (grafica/francobollo-vuoto.svg); quelli pieni, per ora, placeholder.
interface Props {
  totale?: number;
  ottenuti?: string[];
}
const { totale = 9, ottenuti = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const slot = Array.from({ length: totale }, (_, i) => ottenuti[i] ?? null);
---
<section class="strip" aria-labelledby="titolo-francobolli">
  <h2 id="titolo-francobolli" class="visually-hidden">Collezione di francobolli</h2>
  <img class="strip__sfondo" src={`${base}grafica/collezione-francobolli.svg`} alt="" width="528.97" height="132.88" />
  <ul class="strip__slot">
    {slot.map((file) => (
      <li>
        <img
          src={file ? `${base}placeholders/${file}` : `${base}grafica/francobollo-vuoto.svg`}
          alt={file ? 'Francobollo ottenuto' : 'Francobollo ancora da ottenere'}
          width="45.44"
          height="58.1"
        />
      </li>
    ))}
  </ul>
</section>

<style>
  /* Striscia 528,97 x 132,88; slot 45,44 x 58,1 con passo 55,4 (misurato sul mockup) */
  .strip {
    position: relative;
    width: calc(528.97 * var(--u));
    height: calc(132.88 * var(--u));
  }
  .strip__sfondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .strip__slot {
    position: absolute;
    left: calc(20.3 * var(--u));
    top: calc(54.5 * var(--u));
    display: flex;
    gap: calc(9.96 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip__slot img {
    display: block;
    width: calc(45.44 * var(--u));
    height: calc(58.1 * var(--u));
  }
</style>
