---
import '../styles/global.css';

interface Props {
  titolo?: string;
}
const { titolo = 'minuscole – L’universo delle cose' } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#6f211c" />
    <title>{titolo}</title>
  </head>
  <body>
    <div class="foglio">
      <slot />
    </div>
  </body>
</html>
