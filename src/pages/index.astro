---
import Base from '../layouts/Base.astro';
import Zampa from '../components/Zampa.astro';
import Cornice from '../components/Cornice.astro';
import PulsanteGioco from '../components/PulsanteGioco.astro';
import StripFrancobolli from '../components/StripFrancobolli.astro';
import { zampe, zampaVisibile, giochi, francobolli } from '../data/home';
const base = import.meta.env.BASE_URL;
---
<Base>
  <main class="home">
    <img class="home__foglia" src={`${base}grafica/sfondo-foglia.svg`} alt="" aria-hidden="true" width="343.15" height="1200" />

    <h1 class="home__titolo">
      <img src={`${base}grafica/titolo.svg`} alt="minuscole – L’universo delle cose" width="626.78" height="116.61" />
    </h1>

    <nav class="home__zampe" aria-label="Sezioni del sito">
      {zampe.map((z) => <Zampa {...z} visibile={zampaVisibile} />)}
    </nav>

    <div class="home__cornice"><Cornice /></div>

    <div class="home__giochi">
      {giochi.map((g) => <PulsanteGioco {...g} />)}
    </div>

    <div class="home__strip">
      <StripFrancobolli totale={francobolli.totale} ottenuti={francobolli.ottenuti} />
    </div>
  </main>
</Base>

<style>
  /*
    Tutto e posizionato con le coordinate del mockup (pagina 940 x 1200, 1 punto = var(--u)).
    Se lo schermo e piu alto del mockup, ogni blocco scende di una quota (--k) dello spazio in piu:
    cosi le dimensioni restano quelle del mockup e a crescere sono solo gli spazi.
    extra = 100% - 1200 * var(--u)   (100% = altezza della home)
  */
  .home {
    position: relative;
    min-height: max(100dvh, calc(1200 * var(--u)));
  }

  /* Foglia: larga come nel mockup (bordo verticale netto a 343); se la pagina e piu alta si ingrandisce e si ritaglia a destra */
  .home__foglia {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(343.15 * var(--u));
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    z-index: 0;
  }

  .home__titolo {
    position: absolute;
    z-index: 2;
    left: calc(263.2 * var(--u));
    top: calc(100 * var(--u));
    margin: 0;
    line-height: 0;
  }
  .home__titolo img {
    display: block;
    width: calc(626.78 * var(--u));
    height: calc(116.61 * var(--u));
  }

  .home__zampe { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .home__zampe :global(.zampa) { pointer-events: auto; }

  .home__cornice {
    position: absolute;
    z-index: 1;
    left: calc(380.5 * var(--u));
    top: calc(284 * var(--u) + (100% - 1200 * var(--u)) * 0.3);
  }

  .home__giochi {
    position: absolute;
    z-index: 1;
    left: calc(380.5 * var(--u));
    width: calc(528.5 * var(--u));
    top: calc(896 * var(--u) + (100% - 1200 * var(--u)) * 0.65);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .home__strip {
    position: absolute;
    z-index: 1;
    left: calc(380.5 * var(--u));
    top: calc(1037 * var(--u) + (100% - 1200 * var(--u)) * 1);
  }
</style>
