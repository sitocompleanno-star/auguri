---
// Pagina Francobolli (Fase 3), dalla tavola 4 di Francobolli_e_luna_park.pdf (940 x 1200 punti, come la home):
// sfondo caldo sfumato, portafoglio con due icone (busta con cuore = cartolina fiore, cartellina TRAVEL =
// cartolina mappa) e, in basso, la fascia "FRANCOBOLLI" con gli slot (16 per riga, stessa misura della
// striscia in home). I francobolli sbloccati riempiono gli slot in ordine di sblocco; un tocco apre il
// dettaglio, dove si sceglie se metterlo tra i preferiti della home.
// Fase 5 (tavole 4-7 e note della tavola 12): primo tocco su un'icona = il portafoglio si apre (le cartoline
// spuntano); secondo tocco = la cartolina esce e si allarga. Lì si attaccano i francobolli trascinandoli dal
// vassoio (che prende il posto della griglia nella fascia), si gira la cartolina e si scarica il PDF.
// La logica delle cartoline è in src/lib/cartolina-ui.ts; il PDF in src/lib/pdf-cartolina.ts (caricato al clic).
// Lo stato vive in localStorage: al build tutti gli slot sono vuoti e lo script li riempie nel browser.
import Base from '../../layouts/Base.astro';
import { famiglie, tuttiFrancobolli } from '../../data/emozioni.ts';
import { controllaRuota, francobolliDefinitivi } from '../../lib/francobolli-definitivi.ts';
import { cartoline, retroSvg } from '../../data/cartoline.ts';
import { FRANCOBOLLO_VUOTO } from '../../lib/francobolli.ts';
import { MAX_PREFERITI } from '../../lib/stato.ts';

controllaRuota();
const base = import.meta.env.BASE_URL;
const definitivi = JSON.stringify(francobolliDefinitivi());
const totale = tuttiFrancobolli.length; // ruota + speciali dei giochi (Fase 8)
const dev = import.meta.env.DEV;
const g = `${base}grafica/cartoline/`;
const [fiore, mappa] = cartoline;
---
<Base titolo="Collezione di francobolli · minuscole">
  <main class="fb" data-francobolli data-base={base} data-definitivi={definitivi}>
    <a class="fb__indietro" href={base}>← torna alla home</a>
    <h1 class="visually-hidden">Collezione di francobolli</h1>

    <!-- Portafoglio (tavole 4-5) e cartolina (tavole 6-7). Scena in punti mockup: x 0-940, y 160-700 della tavola. -->
    <section class="fb__portafoglio" aria-labelledby="titolo-portafoglio">
      <h2 id="titolo-portafoglio" class="visually-hidden">Portafoglio delle cartoline</h2>
      <div class="scena" data-scena data-stato="chiuso">
        <!-- livelli: fondo della busta aperta, cartoline, tasche davanti, busta chiusa -->
        <img class="liv liv--busta-aperta" src={`${g}busta-aperta.webp`} alt="" width="704" height="828" />
        {cartoline.map((c) => (
          <div class={`cartolina cartolina--${c.id}`} data-cartolina={c.id} data-pos="dentro"
            role="group" aria-roledescription="cartolina" aria-label={c.nome} tabindex="-1">
            <div class="cartolina__giro" data-giro>
              <div class="cartolina__faccia cartolina__fronte" data-fronte>
                <img class="cartolina__img" src={`${base}${c.fronte}`} alt="" width="1772" height="1181" decoding="async" />
                <div class="cartolina__francobolli" data-area aria-label="Francobolli sulla cartolina" role="list"></div>
              </div>
              <div class="cartolina__faccia cartolina__retro" data-retro set:html={retroSvg(c)} />
            </div>
          </div>
        ))}
        <img class="liv liv--busta-tasca" src={`${g}busta-tasca.webp`} alt="" width="702" height="404" />
        <img class="liv liv--cartellina-tasca" src={`${g}cartellina-tasca.webp`} alt="" width="702" height="497" />
        <img class="liv liv--busta-chiusa" src={`${g}busta-chiusa.webp`} alt="" width="702" height="537" />

        <button type="button" class="icona icona--fiore" data-icona={fiore.id} data-nome={fiore.nome}>
          <span class="visually-hidden" data-icona-nome>Apri il portafoglio: {fiore.nome.toLowerCase()}</span>
        </button>
        <button type="button" class="icona icona--mappa" data-icona={mappa.id} data-nome={mappa.nome}>
          <span class="visually-hidden" data-icona-nome>Apri il portafoglio: {mappa.nome.toLowerCase()}</span>
        </button>
      </div>

      <!-- Comandi della cartolina aperta -->
      <div class="comandi" data-comandi hidden>
        <h3 class="visually-hidden" data-titolo-cartolina tabindex="-1"></h3>
        <div class="comandi__riga" role="group" aria-label="Francobollo sulla cartolina">
          <button type="button" class="tondo" data-ruota="-15" aria-label="Ruota il francobollo a sinistra">↺</button>
          <button type="button" class="tondo" data-ruota="15" aria-label="Ruota il francobollo a destra">↻</button>
          <button type="button" class="tondo tondo--testo" data-togli>Togli</button>
        </div>
        <div class="comandi__riga">
          <button type="button" class="fb__bottone fb__bottone--secondario" data-chiudi>← Portafoglio</button>
          <button type="button" class="fb__bottone fb__bottone--secondario" data-gira aria-pressed="false">Gira</button>
          <button type="button" class="fb__bottone" data-pdf>Scarica il PDF</button>
        </div>
        <p id="aiuto-francobollo" class="visually-hidden">
          Trascinalo per spostarlo, o fuori dalla cartolina per toglierlo. Da tastiera: frecce per spostarlo
          (con Maiusc più veloce), Q ed E per ruotarlo, Canc per toglierlo.
        </p>
        <p class="comandi__nota">Stampa al 100% (dimensione reale) su carta 10 x 15, fronte-retro sul lato corto.</p>
      </div>
      <p class="fb__messaggio" data-messaggio role="status"></p>
    </section>

    <section class="fb__fascia" aria-labelledby="titolo-francobolli">
      <h2 id="titolo-francobolli" class="fb__titolo">FRANCOBOLLI</h2>
      <p class="visually-hidden" data-riassunto aria-live="polite">Nessun francobollo sbloccato su {totale}.</p>
      <div class="vassoio" data-vassoio hidden>
        <p class="vassoio__nota" id="nota-vassoio">Trascina un francobollo sulla cartolina. Ne puoi attaccare uno.</p>
        <ul class="vassoio__lista" data-vassoio-lista aria-describedby="nota-vassoio"></ul>
        <p class="vassoio__vuoto" data-vassoio-vuoto hidden>
          Non hai ancora francobolli: li sblocchi scegliendo un'emozione nel <a href={`${base}diario/`}>Diario</a>.
        </p>
      </div>
      <ul class="fb__griglia">
        {tuttiFrancobolli.map(() => (
          <li aria-hidden="true">
            <button type="button" class="fb__francobollo" disabled>
              <img src={`${base}${FRANCOBOLLO_VUOTO}`} alt="" width="45.44" height="58.1" />
              <svg class="fb__cuore" viewBox="0 0 20 18" aria-hidden="true">
                <path d="M10 17C3 12 1 8.5 1 5.5 1 2.8 3.1 1 5.4 1 7.3 1 8.9 2.1 10 3.8 11.1 2.1 12.7 1 14.6 1 16.9 1 19 2.8 19 5.5 19 8.5 17 12 10 17Z" />
              </svg>
            </button>
          </li>
        ))}
      </ul>
      <p class="fb__info" data-info-griglia>
        <span><strong data-conta>0</strong> di {totale}</span>
        <span><svg class="fb__cuore-testo" viewBox="0 0 20 18" aria-hidden="true"><path d="M10 17C3 12 1 8.5 1 5.5 1 2.8 3.1 1 5.4 1 7.3 1 8.9 2.1 10 3.8 11.1 2.1 12.7 1 14.6 1 16.9 1 19 2.8 19 5.5 19 8.5 17 12 10 17Z" /></svg>
          <strong data-num-preferiti>0</strong>/{MAX_PREFERITI} nella home</span>
      </p>
      <p class="fb__nota" data-nota-griglia>Tocca un francobollo per vederlo e sceglierlo per la home.</p>
      <p class="fb__avviso" data-avviso hidden>
        Questo browser non permette di salvare: le scelte valgono solo finché la pagina resta aperta.
      </p>
      <p class="fb__dispositivi">
        <a href={`${base}dispositivi/`}>Dispositivi e copia di sicurezza</a>
        <span class="fb__sync" data-sync-breve hidden><span class="fb__sync-spia" aria-hidden="true"></span><span data-sync-testo></span></span>
      </p>

      {dev && (
        <section class="fb__prova" data-prova aria-labelledby="titolo-prova">
          <h2 id="titolo-prova">Prova (solo con npm run dev)</h2>
          <p>Simula il Diario: assegna un'emozione a un giorno. Non compare nel sito pubblicato.</p>
          <label>Emozione
            <select data-prova-emozione>
              {famiglie.map((f) => (
                <optgroup label={f.nome}>
                  {f.emozioni.flatMap((m) => m.emozioni).map((e) => <option value={e.id}>{e.nome}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
          <label>Giorno <input type="date" data-prova-data /></label>
          <div class="fb__prova-bottoni">
            <button type="button" class="fb__bottone" data-prova-sblocca>Sblocca</button>
            <button type="button" class="fb__bottone" data-prova-caso>5 a caso</button>
            <button type="button" class="fb__bottone" data-prova-memory>Vinci Memory</button>
            <button type="button" class="fb__bottone fb__bottone--secondario" data-prova-azzera>Azzera tutto</button>
          </div>
        </section>
      )}
    </section>

    <dialog class="dettaglio" data-dettaglio aria-labelledby="dettaglio-nome">
      <form method="dialog">
        <button class="dettaglio__chiudi" aria-label="Chiudi">×</button>
      </form>
      <img class="dettaglio__img" data-d-img src={`${base}${FRANCOBOLLO_VUOTO}`} alt="" width="45.44" height="58.1" />
      <h2 id="dettaglio-nome" class="dettaglio__nome" data-d-nome></h2>
      <p class="dettaglio__percorso" data-d-percorso></p>
      <p class="dettaglio__gioco" data-d-gioco hidden></p>
      <p class="dettaglio__info" data-d-info></p>
      <button type="button" class="fb__bottone" data-d-preferito></button>
      <p class="dettaglio__msg" data-d-msg role="status"></p>
    </dialog>
  </main>
</Base>

<script>
  import {
    MAX_PREFERITI, aggiorna, alternaPreferito, conteggi, dataDiOggi, impostaGiorno, leggi, osserva,
    persistente, preferitiValidi, registraVittoria, sbloccati, scrivi, statoVuoto, type Stato,
  } from '../../lib/stato.ts';
  import { emozione, emozioni, famiglia, intermedia, tuttiFrancobolli } from '../../data/emozioni.ts';
  import { FRANCOBOLLO_VUOTO, percorsoFrancobollo } from '../../lib/francobolli.ts';
  import { avviaCartoline } from '../../lib/cartolina-ui.ts';

  const radice = document.querySelector<HTMLElement>('[data-francobolli]')!;
  const base = radice.dataset.base ?? '/';
  const definitivi = new Set<string>(JSON.parse(radice.dataset.definitivi ?? '[]'));
  const $ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = document) => el.querySelector<T>(sel)!;

  // "1º novembre 2026", "12 novembre 2026"
  const dataLunga = (d: string) =>
    new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
      .format(new Date(`${d}T12:00:00Z`))
      .replace(/^1 /, '1º ');

  // ---- Portafoglio e cartoline (Fase 5) ----
  avviaCartoline(radice, base, definitivi);

  // ---- Griglia: slot riempiti in ordine di sblocco ----
  const bottoni = [...document.querySelectorAll<HTMLButtonElement>('.fb__francobollo')];
  let attuale: Stato = statoVuoto();
  const totale = tuttiFrancobolli.length;

  function disegna(s: Stato) {
    attuale = s;
    const ok = sbloccati(s);
    // solo emozioni che esistono nella ruota (se la ruota cambia, i giorni vecchi restano nello stato)
    const ids = [...ok.keys()].filter((id) => emozione(id)).slice(0, bottoni.length);
    const pref = new Set(preferitiValidi(s));
    bottoni.forEach((b, i) => {
      const e = ids[i] ? emozione(ids[i]) : undefined;
      const img = b.querySelector('img')!;
      const src = base + (e ? percorsoFrancobollo(e, definitivi) : FRANCOBOLLO_VUOTO);
      if (img.getAttribute('src') !== src) img.setAttribute('src', src);
      b.disabled = !e;
      b.closest('li')!.toggleAttribute('aria-hidden', !e); // gli slot vuoti non si leggono uno per uno
      if (e) {
        b.dataset.id = e.id;
        b.setAttribute('aria-label', `${e.nome}${pref.has(e.id) ? ', nella home' : ''}`);
      } else {
        delete b.dataset.id;
        b.removeAttribute('aria-label');
      }
      b.classList.toggle('is-preferito', !!e && pref.has(e.id));
    });
    const n = ids.length;
    $('[data-conta]').textContent = String(n);
    $('[data-num-preferiti]').textContent = String(pref.size);
    $('[data-riassunto]').textContent =
      n === 0 ? `Nessun francobollo sbloccato su ${totale}.`
        : `${n} francobolli sbloccati su ${totale}; gli altri ${totale - n} sono ancora da scoprire.`;
    $('[data-avviso]').hidden = persistente();
    if (dialogo.open && aperta) mostraDettaglio(aperta, false);
  }

  // ---- Dettaglio di un francobollo (finestra modale nativa) ----
  const dialogo = $<HTMLDialogElement>('[data-dettaglio]');
  const btnPref = $<HTMLButtonElement>('[data-d-preferito]');
  const msg = $('[data-d-msg]');
  let aperta: string | null = null;

  function mostraDettaglio(id: string, apri = true) {
    const e = emozione(id);
    const ok = sbloccati(attuale);
    if (!e || !ok.has(id)) { if (dialogo.open) dialogo.close(); return; }
    aperta = id;
    const volte = conteggi(attuale).get(id) ?? 0;
    const pref = preferitiValidi(attuale).includes(id);
    $<HTMLImageElement>('[data-d-img]', dialogo).src = base + percorsoFrancobollo(e, definitivi);
    $('[data-d-nome]', dialogo).textContent = e.nome;
    const gioco = $('[data-d-gioco]', dialogo);
    if (e.gioco) {
      // Fase 8: francobollo speciale vinto in un gioco
      $('[data-d-percorso]', dialogo).textContent = 'Francobollo speciale';
      gioco.replaceChildren('Vinto giocando a ', Object.assign(document.createElement('a'), {
        href: `${base}giochi/memory/`, textContent: e.gioco,
      }));
      gioco.hidden = false;
      $('[data-d-info]', dialogo).textContent = `Vinto il ${dataLunga(ok.get(id)!)}`;
    } else {
      gioco.hidden = true;
      $('[data-d-percorso]', dialogo).textContent = `${famiglia(e.famiglia)?.nome} › ${intermedia(e.intermedia)?.nome} › ${e.nome}`;
      $('[data-d-info]', dialogo).textContent =
        `Sbloccato il ${dataLunga(ok.get(id)!)} · scelto ${volte} ${volte === 1 ? 'volta' : 'volte'}`;
    }
    btnPref.textContent = pref ? 'Togli dalla home' : 'Metti nella home';
    btnPref.setAttribute('aria-pressed', String(pref));
    if (apri) {
      msg.textContent = '';
      dialogo.showModal();
    }
  }

  for (const b of bottoni) b.addEventListener('click', () => { if (b.dataset.id) mostraDettaglio(b.dataset.id); });
  dialogo.addEventListener('close', () => {
    // il focus torna al francobollo che era aperto
    if (aperta) document.querySelector<HTMLButtonElement>(`.fb__francobollo[data-id="${aperta}"]`)?.focus();
    aperta = null;
  });
  // tocco fuori dalla finestra = chiudi
  dialogo.addEventListener('click', (ev) => { if (ev.target === dialogo) dialogo.close(); });

  btnPref.addEventListener('click', () => {
    if (!aperta) return;
    const id = aperta;
    const prima = preferitiValidi(leggi()).includes(id);
    const ora = preferitiValidi(aggiorna((s) => alternaPreferito(s, id))).includes(id);
    if (prima === ora) msg.textContent = `Nella home ci sono già ${MAX_PREFERITI} francobolli: togline uno per mettere questo.`;
    else msg.textContent = ora ? 'Fatto: ora lo trovi nella home.' : 'Tolto dalla home.';
  });

  osserva(disegna);

  // ---- Sblocco di prova: solo in sviluppo (nella build pubblicata questo blocco viene eliminato) ----
  if (import.meta.env.DEV) {
    const p = document.querySelector('[data-prova]');
    if (p) {
      const data = $<HTMLInputElement>('[data-prova-data]', p);
      data.value = dataDiOggi();
      $('[data-prova-sblocca]', p).addEventListener('click', () => {
        const id = $<HTMLSelectElement>('[data-prova-emozione]', p).value;
        aggiorna((s) => impostaGiorno(s, data.value || dataDiOggi(), id));
      });
      $('[data-prova-caso]', p).addEventListener('click', () => {
        aggiorna((s) => {
          let t = s;
          for (let i = 0; i < 5; i++) {
            const e = emozioni[Math.floor(Math.random() * emozioni.length)];
            t = impostaGiorno(t, dataDiOggi(new Date(Date.now() - Math.floor(Math.random() * 300) * 864e5)), e.id);
          }
          return t;
        });
      });
      $('[data-prova-memory]', p).addEventListener('click', () => {
        aggiorna((s) => registraVittoria(s, 'memory', 'memory-facile', 6 + Math.floor(Math.random() * 10)));
      });
      $('[data-prova-azzera]', p).addEventListener('click', () => scrivi(statoVuoto()));
    }
  }
</script>

<script>
  // Fase 6: stato breve della sincronizzazione accanto al link "Dispositivi" (solo quando è attiva).
  import { osservaSync } from '../../lib/sincronizza.ts';
  const breve = document.querySelector<HTMLElement>('[data-sync-breve]');
  const TESTI: Record<string, string> = {
    sincronizzato: 'sincronizzato', 'in-corso': 'sincronizzazione…', offline: 'offline', errore: 'errore', ritirato: 'da ricollegare',
  };
  if (breve) {
    osservaSync((i) => {
      breve.hidden = !TESTI[i.fase];
      breve.dataset.fase = i.fase;
      breve.querySelector('[data-sync-testo]')!.textContent = TESTI[i.fase] ?? '';
    });
  }
</script>

<style>
  /*
    Misure in punti mockup (tavola 4, 940 x 1200; 1 punto = var(--u)).
    La pagina è una colonna: in alto il portafoglio (centrato nello spazio libero), in basso la fascia.
    Se lo schermo è più alto del mockup cresce solo lo spazio intorno al portafoglio.
  */
  .fb {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: max(100dvh, calc(1200 * var(--u)));
    background: linear-gradient(90deg, #e8cfc4 0%, #fbf4f0 9%, #f4e5dc 40%, #e9d3c4 100%);
  }

  .fb__indietro {
    position: absolute;
    z-index: 2;
    top: calc(40 * var(--u));
    left: calc(40 * var(--u));
    color: var(--bordeaux);
    font-weight: 700;
    font-size: max(13px, calc(30 * var(--u)));
    text-decoration: none;
  }

  /* Portafoglio: busta x 106-457, cartellina x 483-834, alte 265 */
  .fb__portafoglio {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(150 * var(--u)) 0 calc(60 * var(--u));
  }
  /*
    Fase 5 · Scena del portafoglio e della cartolina (punti mockup; origine = y 160 della tavola, alta 540).
    Livelli estratti dalle tavole 4-5 (public/grafica/cartoline/, vedi scripts/estrai-cartoline.py) e
    posizionati con il riquadro stampato dallo script. Le cartoline sono sempre in grande (782 x 521,3, 3:2)
    e lo script le rimpicciolisce con transform quando stanno nel portafoglio.
  */
  .scena {
    position: relative;
    height: calc(540 * var(--u));
    margin-top: calc(-30 * var(--u));
  }
  .liv {
    position: absolute;
    display: block;
    height: auto;
    pointer-events: none;
    transition: opacity 300ms ease;
    filter: drop-shadow(0 calc(4 * var(--u)) calc(3 * var(--u)) rgb(120 80 70 / 0.16));
  }
  .liv--busta-aperta { left: calc(105.5 * var(--u)); top: calc(14.5 * var(--u)); width: calc(352 * var(--u)); z-index: 1; }
  .liv--busta-tasca { left: calc(106 * var(--u)); top: calc(230 * var(--u)); width: calc(351 * var(--u)); z-index: 3; }
  .liv--cartellina-tasca { left: calc(483 * var(--u)); top: calc(182.5 * var(--u)); width: calc(351 * var(--u)); z-index: 3; }
  .liv--busta-chiusa { left: calc(106 * var(--u)); top: calc(163.5 * var(--u)); width: calc(351 * var(--u)); z-index: 4; }

  /* stati: chiuso (tavola 4), aperto (tavola 5), cartolina (tavole 6-7) */
  .scena[data-stato='chiuso'] .liv--busta-aperta,
  .scena[data-stato='chiuso'] .liv--busta-tasca { opacity: 0; }
  .scena:not([data-stato='chiuso']) .liv--busta-chiusa { opacity: 0; }
  .scena[data-stato='cartolina'] .liv { opacity: 0; }
  .scena[data-stato='cartolina'] .cartolina:not(.is-davanti) { opacity: 0; visibility: hidden; transition: opacity 250ms ease, visibility 0s 250ms; }

  .cartolina {
    position: absolute;
    left: calc(79 * var(--u));
    top: calc(10 * var(--u));
    width: calc(782 * var(--u));
    height: calc(521.333 * var(--u));
    z-index: 2;
    transform-origin: 0 0;
    perspective: calc(2400 * var(--u));
    pointer-events: none;
    transition: opacity 250ms ease;
  }
  .cartolina.is-davanti { z-index: 6; pointer-events: auto; }
  .cartolina:focus { outline: none; }
  .cartolina__giro {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 600ms cubic-bezier(.3,.7,.2,1);
  }
  .cartolina.is-retro .cartolina__giro { transform: rotateY(180deg); }
  .cartolina__faccia {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: calc(20 * var(--u));
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 calc(6 * var(--u)) calc(16 * var(--u)) rgb(90 55 45 / 0.22);
  }
  .cartolina__img { display: block; width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-select: none; }
  .cartolina__retro { transform: rotateY(180deg); }
